# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# One SQLite file per PHPUnit process. TEST_TOKEN is set by tests/bootstrap.php (or by
# ParaTest), so agents running the suite concurrently never share a database.
# Always defined (empty by default) so the URL below is a scalar even when nothing sets it.
TEST_TOKEN=
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test%env(TEST_TOKEN)%.db"
